{
  "info": {
    "name": "Blog Platform Auth API",
    "description": "Comprehensive Postman collection containing all Authentication, MFA, Session Management, and Account Recovery endpoints for the Blog Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Core Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"username\": \"testuser1\",\n  \"password\": \"SecurePass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Multi-Factor Auth (MFA)",
      "item": [
        {
          "name": "Setup MFA",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa/setup",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa", "setup"]
            }
          }
        },
        {
          "name": "Verify MFA Configuration",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa", "verify"]
            }
          }
        },
        {
          "name": "MFA Login Challenge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_FROM_LOGIN_PAYLOAD\",\n  \"token\": \"123456_OR_BACKUP_CODE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa/challenge",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa", "challenge"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Session Management",
      "item": [
        {
          "name": "Get Active Sessions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sessions"]
            }
          }
        },
        {
          "name": "Terminate Specific Session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sessions/SESSION_UUID",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sessions", "SESSION_UUID"]
            }
          }
        },
        {
          "name": "Terminate All Other Sessions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sessions/all",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sessions", "all"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Account Recovery",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_FROM_EMAIL_LINK\",\n  \"newPassword\": \"NewSecurePass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "reset-password"]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/verify-email/TOKEN_FROM_EMAIL",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "verify-email", "TOKEN_FROM_EMAIL"]
            }
          }
        }
      ]
    }
  ]
}
